{
  "name": "discord-auto-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A desktop app that completes Discord quests for games you do not own.",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev.mjs dev",
    "build": "npm run version:check && tsc --noEmit && vite build",
    "build:payload": "node scripts/build-payload.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:payload": "node scripts/check-payload.mjs",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/dev.mjs",
    "verify": "cargo run --manifest-path src-tauri/Cargo.toml --example verify",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
